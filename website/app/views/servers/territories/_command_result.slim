/ locals: command, retry_territory
- if territory_command_inline?(command)
  span id=server_command_id(command) class="d-inline-flex"
    - if command.completed?
      span.text-success.px-1
        i.bi.bi-check-circle-fill
    - else
      = territory_command_retry_button(command, retry_territory)
- else
  div id=server_command_id(command)
    - if command.completed?
      .d-flex.align-items-center.justify-content-center.gap-1.text-success.small.fw-medium.py-1
        i.bi.bi-check-circle-fill
        = territory_command_copy(command)[:past_tense]
    - else
      .small.text-danger.mb-2
        i.bi.bi-exclamation-circle-fill.me-1
        = territory_command_failure_message(command)
      = territory_command_retry_button(command, retry_territory)
