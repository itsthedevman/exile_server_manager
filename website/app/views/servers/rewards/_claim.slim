/ locals: current_server, reward_claim
.border.rounded.p-3.bg-body-tertiary
  .d-flex.align-items-center.justify-content-between.gap-2
    .fw-medium
      i.bi.bi-inbox.text-warning.me-2
      | Rewards waiting for you
    - if reward_claim.failed?
      span.badge.text-bg-danger Needs an admin

  = render "servers/rewards/receipt", contents: reward_claim.contents, \
    include_vehicles: !reward_claim_deliverable?(current_server, reward_claim)

  - if reward_claim_failures(reward_claim).any?
    .mt-2
      - reward_claim_failures(reward_claim).each do |failure|
        .small.text-danger
          i.bi.bi-exclamation-triangle.me-1
          = failure

  - if reward_claim.failed?
    .small.text-muted.mt-2
      | Nothing is lost. Your server's admins can release this so you can try again.
  - elsif !current_server.connected?
    .small.text-muted.mt-2
      i.bi.bi-plug.me-1
      | #{current_server.server_id} is offline. Rewards are handed over in game, so this has to wait until it is back.
  - else
    = render "servers/rewards/deliver_form", current_server:, reward_claim:

/ The packages and the code box are gone off the page while this is here, so something has to say where they went
.small.text-muted.mt-2
  | You can only redeem a new reward once this one is delivered.
