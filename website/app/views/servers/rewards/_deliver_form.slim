/ locals: current_server, reward_claim
= form_with url: server_reward_path(current_server.public_id), method: :post, class: "mt-3"
  = hidden_field_tag :idempotency_key, SecureRandom.uuid

  - reward_claim.contents.vehicles.each_with_index do |vehicle, index|
    .border-top.pt-2.mt-2
      .small.fw-medium
        i.bi.bi-truck.me-1
        = vehicle.display_name

      .row.g-2.mt-1
        - if vehicle.spawn_location == "player_decides"
          .col-12.col-sm-6
            = label_tag "vehicles_#{index}_spawn_location", "Where should it go?", class: "form-label small mb-1"
            = select_tag "vehicles[#{index}][spawn_location]", \
              options_for_select(reward_spawn_location_options), \
              class: "form-select form-select-sm", \
              id: "vehicles_#{index}_spawn_location"

        - if reward_vehicle_needs_territory?(vehicle)
          .col-12.col-sm-6
            = label_tag "vehicles_#{index}_territory_id", "Which territory?", class: "form-label small mb-1"
            = turbo_frame_tag "reward_territory_#{index}", \
              src: territories_server_reward_path(current_server.public_id, index:), loading: :lazy
              select.form-select.form-select-sm disabled=true
                option Loading your territories…

        .col-12.col-sm-6
          = label_tag "vehicles_#{index}_pin_code", "Pin to lock it with", class: "form-label small mb-1"
          = text_field_tag "vehicles[#{index}][pin_code]", nil, \
            class: "form-control form-control-sm", \
            id: "vehicles_#{index}_pin_code", \
            inputmode: "numeric", pattern: "[0-9]{4}", maxlength: 4, \
            placeholder: "1234", autocomplete: "off", required: true

  .d-grid.mt-3
    = submit_tag "Deliver", name: nil, class: "btn btn-success btn-sm"
