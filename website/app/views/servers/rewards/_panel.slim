/ locals: current_server, reward_package, reward_claim, outcome
#reward_panel
  - if outcome
    .alert.py-2.px-3.small class=outcome.css_class role="alert"
      = outcome.message

  / A waiting claim owns the whole block. Nothing else can be taken until it is delivered, so listing packages under
  / it would only be a row of refusals with an explanation attached to each one.
  - if reward_claim
    = render "servers/rewards/claim", current_server:, reward_claim:
  - else
    / Only the default is ever rendered here. A code the player types appends its package alongside it and is gone
    / again on the next render, which is the whole point of a code.
    #reward_packages.d-flex.flex-column.gap-3
      - if reward_package
        = render "servers/rewards/package", current_server:, package: reward_package

    - if reward_package
      hr.my-3

    = render "servers/rewards/redeem_code", current_server:
