/ locals: current_server
- if current_server.connected?
  = form_with url: server_gamble_path(current_server.public_id), method: :post, data: {controller: "gambling", action: "turbo:submit-end->gambling#rotateKey"} do |form|
    = form.hidden_field :idempotency_key, value: SecureRandom.uuid, data: {gambling_target: "idempotencyKey"}
    .d-flex.flex-wrap.gap-2
      = form.text_field :amount, class: "form-control flex-grow-1", style: "min-width: 8rem;", placeholder: "Amount to gamble", inputmode: "numeric", autocomplete: "off", required: true, aria: {label: "Amount to gamble"}, data: {gambling_target: "amount"}
      button.btn.btn-outline-secondary type="button" data-action="gambling#fill" data-gambling-value-param="half"
        | Half
      button.btn.btn-outline-secondary type="button" data-action="gambling#fill" data-gambling-value-param="all"
        | All
      = form.submit "Gamble", name: nil, class: "btn btn-warning"
- else
  .text-muted.small.text-center.py-2
    i.bi.bi-plug.me-1
    | #{current_server.server_name} is offline. Betting is unavailable.
