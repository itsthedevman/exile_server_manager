/ locals: current_server
- if current_server.connected?
  = form_with url: server_sqf_path(current_server.public_id), method: :post, data: {action: "formdata->sqf#fillFormData turbo:submit-end->sqf#rotateKey"} do |form|
    = form.hidden_field :idempotency_key, value: SecureRandom.uuid, data: {sqf_target: "idempotencyKey"}

    .sqf-editor data-sqf-target="editor"

    .d-flex.flex-wrap.gap-2.align-items-center.mt-3
      label.form-label.mb-0.small.text-muted for="sqf-run-on" Run on
      select#sqf-run-on.form-select.w-auto data-sqf-target="mode" data-action="sqf#modeChanged"
        option value="server" Server process
        option value="all" All players
        option value="player" Specific player
      .flex-grow-1 data-sqf-target="playerField" hidden=true
        input.form-control type="text" placeholder="Player's Steam UID" inputmode="numeric" autocomplete="off" data-sqf-target="playerUid"
      = form.submit "Run", name: nil, class: "btn btn-danger"
      button.btn.btn-outline-secondary type="button" data-action="sqf#clear"
        | Clear
- else
  .text-muted.small.text-center.py-2
    i.bi.bi-plug.me-1
    | #{current_server.server_name} is offline. SQF is unavailable.
