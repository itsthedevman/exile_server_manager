/ locals: current_server, lookback, lookback_options, search_name, players, fetched_at, row_limit
.card
  .card-header.d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
    / A name search reaches past every window, so the window control has nothing to steer while one is on screen.
    - if search_name
      .d-flex.align-items-center.gap-2
        span.badge.text-bg-primary.d-inline-flex.align-items-center.gap-1
          i.bi.bi-search
          | Matching "#{search_name}"
        = link_to "Clear", list_server_players_path(current_server.public_id, window: lookback), class: "btn btn-sm btn-link p-0"
    - else
      .btn-group.btn-group-sm[role="group" aria-label="Look-back window"]
        - lookback_options.each do |key, window|
          = link_to window[:label],
            list_server_players_path(current_server.public_id, window: key),
            class: class_names("btn", key == lookback ? "btn-primary" : "btn-outline-secondary")

    .d-flex.align-items-center.gap-3
      - if fetched_at
        = render "shared/data_freshness", at: fetched_at

  - if players.nil?
    .card-body.text-center.py-5
      i.bi.bi-plug.text-muted.fs-1.d-block.mb-3
      h5.text-light.mb-2 Can't reach #{current_server.server_name}
      p.text-muted.mb-0 The server is offline or unreachable, so we couldn't load its players. Try again once it's back up.

  - elsif players.empty? && search_name
    .card-body.text-center.py-5
      i.bi.bi-person-x.text-muted.fs-1.d-block.mb-3
      h5.text-light.mb-2 Nobody named "#{search_name}"
      p.text-muted.mb-2 No account on #{current_server.server_name} has that in its name, however long ago they played.
      = link_to "Back to recent players", list_server_players_path(current_server.public_id, window: lookback), class: "btn btn-sm btn-outline-secondary"

  - elsif players.empty?
    .card-body.text-center.py-5
      i.bi.bi-person-x.text-muted.fs-1.d-block.mb-3
      h5.text-light.mb-2 Nobody in the last #{lookback_options[lookback][:label]}
      p.text-muted.mb-0 No one has connected to #{current_server.server_name} in this window. Try a wider one.

  - else
    div data-controller="players-table" data-players-table-storage-key-value=players_table_storage_key(current_server, lookback:, search_name:) data-players-table-search-url-value=list_server_players_path(current_server.public_id)
      .card-body.border-bottom
        .row.g-2.align-items-center
          .col-12.col-md-5
            .input-group.input-group-sm
              span.input-group-text
                i.bi.bi-search
              input.form-control[type="search" placeholder="Search by name or Steam UID" aria-label="Search players" data-players-table-target="search" data-action="input->players-table#filter"]

          .col-auto
            .form-check.form-switch.mb-0
              input.form-check-input#players_online_only[type="checkbox" data-players-table-target="onlineOnly" data-action="change->players-table#filter"]
              label.form-check-label.small[for="players_online_only"] Online only

          .col-auto
            .form-check.form-switch.mb-0
              input.form-check-input#players_stuck_only[type="checkbox" data-players-table-target="stuckOnly" data-action="change->players-table#filter"]
              label.form-check-label.small[for="players_stuck_only" title="Players Exile holds a row for but can't spawn. Only a reset clears it."] Stuck only

          .col-auto.ms-md-auto
            small.text-muted data-players-table-target="count"

      .table-responsive
        table.table.table-hover.align-middle.mb-0
          thead
            tr
              th.sortable-header role="button" data-sort-key="name" data-players-table-target="sortHeader" data-action="click->players-table#sort"
                | Player
                i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
              th.sortable-header role="button" data-sort-key="status" data-sort-numeric="true" data-players-table-target="sortHeader" data-action="click->players-table#sort"
                | Status
                i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
              th.sortable-header.text-end role="button" data-sort-key="poptabs" data-sort-numeric="true" data-players-table-target="sortHeader" data-action="click->players-table#sort"
                | Poptabs
                i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
              th.sortable-header.text-end role="button" data-sort-key="score" data-sort-numeric="true" data-players-table-target="sortHeader" data-action="click->players-table#sort"
                | Score
                i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
              th.sortable-header.text-end role="button" data-sort-key="kd" data-sort-numeric="true" data-players-table-target="sortHeader" data-action="click->players-table#sort"
                | K/D
                i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
              th.sortable-header.text-end role="button" data-sort-key="connections" data-sort-numeric="true" data-players-table-target="sortHeader" data-action="click->players-table#sort"
                | Connections
                i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
              th.text-end
                span.visually-hidden Actions
          tbody
            - players.each do |player|
              tr data-players-table-target="row" data-online=player[:online].to_s data-stuck=player_row_stuck?(player).to_s data-search=player_search_terms(player) data-sort-name=player[:name].to_s.downcase data-sort-status=(player[:online] ? 1 : 0) data-sort-poptabs=(player[:money] || -1) data-sort-score=player[:score].to_i data-sort-kd=player_kill_death_ratio(player) data-sort-connections=player[:total_connections].to_i
                td
                  .fw-medium.text-truncate = player[:name]
                  small.text-muted.font-monospace = player[:uid]
                td
                  - if player[:online]
                    span.badge.text-bg-success.me-1 Online
                  - else
                    span.badge.text-bg-secondary.me-1 Offline
                  = player_status_pill(player_row_status(player))
                  - if (last_seen = player_last_seen_at(player))
                    .small.text-muted
                      - if player[:online]
                        |> Connected
                      - else 
                        |> Last seen
                      span data-controller="relative-time" data-relative-time-datetime-value=last_seen.iso8601
                        = last_seen.strftime("%b %-d, %Y %-I:%M %p")
                td.text-end
                  - if player[:money]
                    = poptabs(player[:money], inline: true)
                  - else
                    span.text-muted title="No player on the server right now" —
                  .small.text-muted
                    = poptabs(player[:locker], inline: true)
                    | locker
                td.text-end = number_with_delimiter(player[:score])
                td.text-end
                  = player_kill_death_ratio(player)
                  .small.text-muted.ms-1 = "#{player[:kills]}/#{player[:deaths]}"
                td.text-end = number_with_delimiter(player[:total_connections])
                td.text-end
                  / Breaks out of the players_list frame this row lives in - otherwise Turbo tries to load the show
                  / page into the frame and discards it for lacking a matching turbo-frame.
                  = link_to server_player_path(current_server.public_id, player[:uid]), class: "btn btn-sm btn-outline-primary", title: "View player", data: {turbo_frame: "_top"}
                    i.bi.bi-box-arrow-in-right

      .card-body.text-center.py-5[hidden data-players-table-target="empty"]
        i.bi.bi-search.text-muted.fs-1.d-block.mb-3
        h5.text-light.mb-2 No matches
        - if search_name
          p.text-muted.mb-0 Nobody in these results matches what you're looking for.
        - else
          / Reading "no matches" as "never played here" is the mistake this catches: the box only ever searched the
          / rows this window loaded. The escalation asks the server about every account it has.
          p.text-muted.mb-3 Nobody loaded in this window matches. They may not have played in the last #{lookback_options[lookback][:label]}.
          / Href and visibility come from the controller, which knows what is currently in the search box.
          = link_to "#", class: "btn btn-sm btn-outline-primary", hidden: true, data: {players_table_target: "searchAll"} do
            i.bi.bi-binoculars.me-1
            | Search every player on #{current_server.server_name} by name

      .card-footer.d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
        / The note describes the whole capped fetch, so the controller hides it the moment a search or filter narrows
        / what's on screen - the visible count is the honest one then. The wrapper stays put to hold the left slot.
        div
          - if players.size >= row_limit
            small.text-warning data-players-table-target="limitWarning"
              i.bi.bi-exclamation-triangle.me-1
              - if search_name
                | Showing the #{number_with_delimiter(row_limit)} most recent matches. Try a more specific name.
              - else
                | Showing the #{number_with_delimiter(row_limit)} most recent. Narrow the window to see fewer, older players.

        div.d-flex.align-items-center.gap-2[hidden data-players-table-target="pagination"]
          button.btn.btn-sm.btn-outline-secondary[type="button" data-players-table-target="previous" data-action="players-table#previous"]
            i.bi.bi-chevron-left
          small.text-muted data-players-table-target="pageInfo"
          button.btn.btn-sm.btn-outline-secondary[type="button" data-players-table-target="next" data-action="players-table#next"]
            i.bi.bi-chevron-right
