/ Compact My Player glance for the hub card; full detail lives on /me.
/ locals: current_server, current_player
- if current_player
  .card-body
    .d-flex.align-items-center.gap-3.mb-3
      = render "servers/players/status_avatar", player: current_player, viewing_self: true, size: 48
      .min-w-0
        .d-flex.align-items-center.gap-2
          span.fw-bold.text-truncate.min-w-0 = current_player.name
          = player_status_pill(player_status(current_player))
        .text-muted.small.font-monospace.text-truncate = current_player.uid

    .row.g-2.text-center.mb-3
      .col-6
        .text-muted.small.text-uppercase Pocket
        .fs-5.fw-bold.text-success
          - if current_player.alive?
            = poptabs(current_player.money, inline: true)
          - else
            i.bi.bi-dash-lg.text-muted[role="img" aria-label="No pocket cash"]
      .col-6
        .text-muted.small.text-uppercase Locker
        #player_locker.fs-5.fw-bold.text-success = poptabs(current_player.locker, inline: true)

    .d-flex.justify-content-around.text-center.border-top.border-secondary.pt-3
      div
        .text-muted.small.text-uppercase Respect
        .fw-bold = number_with_delimiter(current_player.score)
      div
        .text-muted.small.text-uppercase K/D
        .fw-bold = current_player.kd_ratio
        
      - if command_accessible?("territories")
        div
          .text-muted.small.text-uppercase Territories
          .fw-bold = current_player.territories.size

- elsif current_server.connected?
  .card-body.text-center.text-muted.py-5
    i.bi.bi-person-x.fs-3.d-block.mb-2
    | No player on this server yet.

- else
  .card-body.text-center.text-muted.py-5
    i.bi.bi-plug.fs-3.d-block.mb-2
    | #{current_server.server_id} is offline.
