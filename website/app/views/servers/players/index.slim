/ locals: current_server, lookback
- content_for :title, "Players on #{current_server.server_name}"

= render "servers/container", current_server: do
  .d-flex.mb-4.align-items-center
    div
      h1.mb-1 Players
      p.text-muted.mb-0 Everyone who's connected recently. Search, sort, or filter to online-only to track down a specific player.

  = turbo_frame_tag "players_list",
    src: list_server_players_path(current_server.public_id, window: lookback),
    loading: :lazy

    .card
      .card-body.text-center.text-muted.py-5
        .spinner-border.spinner-border-sm.me-2[role="status"]
        | Loading players...
