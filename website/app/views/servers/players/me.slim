- content_for :title, "My Player on #{current_server.server_name}"

.container.window
  / Page header
  .d-flex.align-items-center.justify-content-between.mb-4.flex-wrap.gap-3
    div
      h1.mb-1 My Player
      .d-flex.align-items-center.gap-2.flex-wrap.text-muted
        - if current_server.connected?
          .server-status.server-status--online
        - elsif current_server.disconnected_at&.> 1.hour.ago
          .server-status.server-status--warning
        - else
          .server-status.server-status--offline
        .text-light.fw-medium = current_server.server_name
        .mx-1 -
        div
          = current_server.community.community_name
        - if current_server.connected?
          .mx-1 -
          div
            i.bi.bi-clock-history.me-1
            | Online for #{current_server.uptime}
    button.btn.btn-outline-secondary.btn-sm[type="button"]
      i.bi.bi-arrow-left-right.me-2
      | Switch server

  - if current_player
    / Identity strip
    .card.mb-4
      .card-body
        .d-flex.align-items-center.gap-3.flex-wrap
          - if current_user.steam_data&.avatar
            img.rounded-circle.border.border-2.border-success[
              src=current_user.steam_data.avatar
              alt=current_user.steam_data.username
              width="64"
              height="64"
            ]
          - else
            img.rounded-circle.border.border-2.border-success[
              src=image_url("default_steam_avatar.png")
              alt="Default Steam Avatar"
              width="64"
              height="64"
            ]
          div
            h2.mb-0 = current_player.name
            small.text-muted.font-monospace = current_player.uid

    .row.g-4.mb-4
      / Character status
      .col-12.col-xl-6
        .card.h-100
          .card-header
            h5.mb-0
              i.bi.bi-heart-pulse.text-danger.me-2
              | Status

          .card-body
            - if player_alive?(current_player)
              .mb-3
                .d-flex.justify-content-between.mb-1
                  span
                    i.bi.bi-heart-fill.text-danger.me-2
                    | Health
                  span.text-muted = "#{player_health_percentage(current_player)}%"
                .progress[style="height: 0.5rem;"]
                  .progress-bar.bg-danger[role="progressbar" style="width: #{player_health_percentage(current_player)}%"]

              .mb-3
                .d-flex.justify-content-between.mb-1
                  span
                    i.bi.bi-egg-fried.text-warning.me-2
                    | Hunger
                  span.text-muted = "#{player_hunger_percentage(current_player)}%"
                .progress[style="height: 0.5rem;"]
                  .progress-bar.bg-warning[role="progressbar" style="width: #{player_hunger_percentage(current_player)}%"]

              div
                .d-flex.justify-content-between.mb-1
                  span
                    i.bi.bi-droplet-fill.text-info.me-2
                    | Thirst
                  span.text-muted = "#{player_thirst_percentage(current_player)}%"
                .progress[style="height: 0.5rem;"]
                  .progress-bar.bg-info[role="progressbar" style="width: #{player_thirst_percentage(current_player)}%"]
            - else
              .text-center.text-muted.py-4
                i.bi.bi-person-x.fs-3.d-block.mb-2
                | No active character

      / Account stats
      .col-12.col-xl-6
        .card.h-100
          .card-header
            h5.mb-0
              i.bi.bi-bank.text-success.me-2
              | Money

          .card-body
            .mb-3
              .text-muted.small.text-uppercase Pocket
              .fs-2.fw-bold.text-success
                - if player_alive?(current_player)
                  = poptabs(current_player.money)
                - else
                  span.text-muted 0
            div
              .text-muted.small.text-uppercase Locker
              .fs-2.fw-bold.text-success
                = poptabs(current_player.locker)

      .col-12.col-xl-6
        .card.h-100
          .card-header
            h5.mb-0
              i.bi.bi-star.text-warning.me-2
              | Scoreboard

          .card-body
            .row.g-3.text-center.mt-1
              .col-3
                .text-muted.small.text-uppercase Respect
                .fs-4.fw-bold = number_with_delimiter(current_player.score)
              .col-3
                .text-muted.small.text-uppercase Kills
                .fs-4.fw-bold.text-success = number_with_delimiter(current_player.kills)
              .col-3
                .text-muted.small.text-uppercase Deaths
                .fs-4.fw-bold.text-danger = number_with_delimiter(current_player.deaths)
              .col-3
                .text-muted.small.text-uppercase K/D
                .fs-4.fw-bold = player_kill_death_ratio(current_player)

      .col-12.col-xl-6
        .card.h-100
          .card-header
            h5.mb-0
              i.bi.bi-file-person.text-info.me-2
              | About

          .card-body
            .d-flex.justify-content-between.mb-2
              span.text-muted.small.text-uppercase Member since
              span.fw-medium = ESM::Time.parse(current_player.first_connect_at).strftime("%b %-d, %Y")
            .d-flex.justify-content-between.mb-2
              span.text-muted.small.text-uppercase Last seen
              - if current_player.last_disconnect_at
                span.fw-medium = "#{ESM::Time.distance_of_time_in_words(ESM::Time.parse(current_player.last_disconnect_at), precise: false)} ago"
              - else
                span.fw-medium.text-success Online now
            .d-flex.justify-content-between
              span.text-muted.small.text-uppercase Connections
              span.fw-medium = number_with_delimiter(current_player.total_connections)

    / Territories
    .d-flex.align-items-center.mb-3
      h4.mb-0
        i.bi.bi-flag-fill.text-warning.me-2
        | Territories
        span.badge.bg-secondary.ms-2 = current_player.territories.size

    - if current_player.territories.any?
      .row.g-3
        - current_player.territories.each do |territory|
          .col-12.col-md-6.col-lg-4
            .card.h-100.territory-card
              = link_to server_territory_path(current_server.public_id, territory.id), class: "card-body text-decoration-none text-reset d-block", data: {turbo_frame: "territory_detail_frame"}
                .d-flex.align-items-center.gap-3
                  img.rounded.border.border-secondary.flex-shrink-0[
                    src=territory.flag_path
                    alt="Territory flag"
                    width="48"
                    height="48"
                    style="object-fit: cover;"
                  ]
                  .flex-grow-1.overflow-hidden
                    .d-flex.align-items-center.gap-2
                      - if territory.stolen?
                        span.badge.bg-danger.flex-shrink-0
                          i.bi.bi-exclamation-triangle-fill.me-1
                          | Stolen
                      h6.mb-0.text-truncate = territory.name
                    small.text-muted.font-monospace = territory.id
                  i.bi.bi-chevron-right.text-muted.flex-shrink-0

              - if territory_payment_due?(territory)
                .card-footer.bg-transparent.border-top-0.pt-0
                  = territory_payment_section(territory)
                  .mt-2
                    = render "servers/territories/pay_button", server_public_id: current_server.public_id, territory_id: territory.id, surface: "card"
    - else
      .card.border-secondary
        .card-body.text-center.py-5
          i.bi.bi-flag.text-muted.fs-1.d-block.mb-3
          p.text-muted.mb-0 No territories on this server yet

    / Territory detail modal — lazy-loaded into the frame when a card is clicked
    = render "shared/turbo_modal", id: "territory_detail", class: "modal-lg"

  - else
    / No character on this server
    .card.border-secondary
      .card-body.text-center.py-5
        i.bi.bi-person-x.text-muted.fs-1.d-block.mb-3
        h5.text-light.mb-2 No character on #{current_server.server_name}
        p.text-muted.mb-0 You haven't spawned in on this server yet. Hop in-game to create your character, then check back here.
