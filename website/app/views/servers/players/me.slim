- content_for :title, "My Player on #{current_server.server_name}"

= render "servers/container", current_server: do
  / Page header
  .d-flex.mb-4.align-items-center
    h1.mb-1 My Player
    - if current_server.connected? && command_accessible?("stuck")
      .ms-auto.d-flex.flex-column.align-items-end.gap-2
        = button_to reset_me_server_players_path(current_server), params: {idempotency_key: SecureRandom.uuid, dom_id: "player_action_result"}, class: "btn btn-outline-danger btn-sm", form: {data: {turbo_confirm: "Reset your character on #{current_server.server_name}?\nThis wipes your current character - you'll lose all of your items, respawn fresh, and it can't be undone."}} do
          i.bi.bi-arrow-counterclockwise.me-1
          | I'm stuck - reset me!
        #player_action_result
    
  - if current_player
    #player_overview
      = render "servers/players/overview", current_server:, current_player:, viewing_self: true, fetched_at: Time.current

    / Territory detail modal — lazy-loaded into the frame when a card is clicked
    = render "shared/turbo_modal", id: "territory_detail", class: "modal-lg"

  - elsif current_server.connected?
    = render "servers/players/no_character", current_server:, viewing_self: true

  - else
    / Server is offline, so we couldn't load the player's data
    .card.border-secondary
      .card-body.text-center.py-5
        i.bi.bi-plug.text-muted.fs-1.d-block.mb-3
        h5.text-light.mb-2 #{current_server.server_name} is offline
        p.text-muted.mb-0 We can't load your character while the server is offline. Check back once it's back up.
