- content_for :title, "My Player on #{current_server.server_name}"

.container.window
  / Page header
  .d-flex.align-items-center.justify-content-between.mb-4.flex-wrap.gap-3
    div
      h1.mb-1 My Player
      .d-flex.align-items-center.gap-2.flex-wrap.text-muted
        - if current_server.connected?
          .server-status.server-status--online
        - elsif current_server.disconnected_at&.> 1.hour.ago
          .server-status.server-status--warning
        - else
          .server-status.server-status--offline
        .text-light.fw-medium = current_server.server_name
        .mx-1 -
        div
          = current_server.community.community_name
        - if current_server.connected? && current_server.server_start_time?
          .mx-1 -
          div
            i.bi.bi-clock-history.me-1
            | Online for #{current_server.uptime}
    button.btn.btn-outline-secondary.btn-sm[type="button"]
      i.bi.bi-arrow-left-right.me-2
      | Switch server

  - if current_player
    #player_overview
      = render "servers/players/overview", current_server:, current_player:

    / Territory detail modal — lazy-loaded into the frame when a card is clicked
    = render "shared/turbo_modal", id: "territory_detail", class: "modal-lg"

  - elsif current_server.connected?
    / No character on this server
    .card.border-secondary
      .card-body.text-center.py-5
        i.bi.bi-person-x.text-muted.fs-1.d-block.mb-3
        h5.text-light.mb-2 No character on #{current_server.server_name}
        p.text-muted.mb-0 You haven't spawned in on this server yet. Hop in-game to create your character, then check back here.

  - else
    / Server is offline, so we couldn't load the player's data
    .card.border-secondary
      .card-body.text-center.py-5
        i.bi.bi-plug.text-muted.fs-1.d-block.mb-3
        h5.text-light.mb-2 #{current_server.server_name} is offline
        p.text-muted.mb-0 We can't load your character while the server is offline. Check back once it's back up.
