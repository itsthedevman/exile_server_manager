/ locals: current_server, target_uid, target_player, identity, fetched_at
- content_for :title, "#{target_player&.name || "Player"} on #{current_server.server_name}"

= render "servers/container", current_server: do
  / Page header
  .d-flex.mb-4.align-items-center.gap-3
    = link_to server_players_path(current_server.public_id), class: "btn btn-sm btn-outline-secondary", title: "Back to players"
      i.bi.bi-arrow-left
    div
      h1.mb-0 Player details
    - if current_server.connected? && command_accessible?("reset")
      .ms-auto.d-flex.flex-column.align-items-end.gap-2
        = button_to reset_server_player_path(current_server, target_uid), params: {idempotency_key: SecureRandom.uuid, dom_id: "player_action_result"}, class: "btn btn-outline-danger btn-sm", form: {data: {turbo_confirm: "Reset #{target_player&.name || "this player"}'s player on #{current_server.server_name}?\nThis wipes their player - they lose all items and respawn fresh, and it can't be undone."}} do
          i.bi.bi-arrow-counterclockwise.me-1
          | Reset player
        #player_action_result

  - if identity
    = render "servers/players/identity", current_server:, target_uid:, target_player:, identity:

  - if target_player
    #player_overview
      = render "servers/players/overview", current_server:, current_player: target_player, viewing_self: false, fetched_at:

    / Territory detail modal — lazy-loaded into the frame when a card is clicked
    = render "shared/turbo_modal", id: "territory_detail", class: "modal-lg"

  - elsif current_server.connected?
    = render "servers/players/no_player", current_server:, viewing_self: false

  - else
    / Server is offline, so we couldn't load the player's data
    .card.border-secondary
      .card-body.text-center.py-5
        i.bi.bi-plug.text-muted.fs-1.d-block.mb-3
        h5.text-light.mb-2 #{current_server.server_name} is offline
        p.text-muted.mb-0 We can't load this player while the server is offline. Check back once it's back up.
