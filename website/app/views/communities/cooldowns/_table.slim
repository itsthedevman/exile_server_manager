/ locals: cooldowns, players, servers
.table-responsive
  table.table.table-hover.align-middle.mb-0
    thead
      tr
        th.sortable-header role="button" data-sort-key="player" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Name
          i.bi.bi-chevron-expand.text-muted.ms-1.sort-indicator
        th.sortable-header role="button" data-sort-key="command" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Command
          i.bi.bi-chevron-expand.text-muted.ms-1.sort-indicator
        th.sortable-header role="button" data-sort-key="server" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Server
          i.bi.bi-chevron-expand.text-muted.ms-1.sort-indicator
        th.sortable-header role="button" data-sort-key="remaining" data-sort-numeric="true" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Remaining
          i.bi.bi-chevron-expand.text-muted.ms-1.sort-indicator
        th
          span.visually-hidden Actions

    tbody
      - cooldowns.each do |cooldown|
        tr data-cooldown-filters-target="row" *cooldown_row_attributes(cooldown, players[cooldown.id], servers)
          td
            .fw-medium.text-truncate = cooldown_player_name(cooldown, players[cooldown.id])
            - if cooldown_player_uid_line(cooldown, players[cooldown.id])
              small.text-muted.font-monospace.d-block = cooldown_player_uid_line(cooldown, players[cooldown.id])
          td.font-monospace.small
            = cooldown.command_name
            - if cooldown.scope_key.present?
              span.badge.text-bg-secondary.ms-2 = cooldown.scope_key
          td.small = cooldown_server_label(cooldown, servers)
          td.small
            - if cooldown.active?
              span.badge.text-bg-warning = cooldown_time_left(cooldown)
            - else
              span.badge.text-bg-secondary = cooldown_time_left(cooldown)
          td.text-end.text-nowrap
            button.btn.btn-sm.btn-link.p-0.text-decoration-none type="button" data-action="click->cooldown-filters#only" *cooldown_row_filters(cooldown, players[cooldown.id], servers)
              | Select
            - if cooldown_player_page_path(cooldown, players[cooldown.id], servers)
              = link_to cooldown_player_page_path(cooldown, players[cooldown.id], servers),
                class: "btn btn-sm btn-outline-primary ms-3",
                title: "View player"
                i.bi.bi-box-arrow-in-right
            - elsif cooldown_player_page_unavailable_reason(cooldown, players[cooldown.id], servers)
              / A disabled button swallows the hover, so the tooltip hangs off a wrapper around it
              span.d-inline-block.ms-3[
                tabindex="0"
                data-bs-toggle="tooltip"
                title=cooldown_player_page_unavailable_reason(cooldown, players[cooldown.id], servers)
              ]
                button.btn.btn-sm.btn-outline-primary type="button" disabled=true aria-label="View player"
                  i.bi.bi-box-arrow-in-right
