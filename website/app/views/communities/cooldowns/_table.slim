/ locals: cooldowns, players, servers
.table-responsive
  table.table.table-hover.align-middle.mb-0
    thead
      tr
        th.sortable-header.small.text-uppercase.text-muted role="button" data-sort-key="player" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Player
          i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
        th.sortable-header.small.text-uppercase.text-muted role="button" data-sort-key="command" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Command
          i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
        th.sortable-header.small.text-uppercase.text-muted role="button" data-sort-key="server" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Server
          i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
        th.sortable-header.small.text-uppercase.text-muted role="button" data-sort-key="remaining" data-sort-numeric="true" data-cooldown-filters-target="sortHeader" data-action="click->cooldown-filters#sort"
          | Remaining
          i.bi.bi-chevron-expand.small.text-muted.ms-1.sort-indicator
        th
          span.visually-hidden Actions

    tbody
      - cooldowns.each do |cooldown|
        tr data-cooldown-filters-target="row" *cooldown_row_attributes(cooldown, players[cooldown.id], servers)
          td = cooldown_player_name(cooldown, players[cooldown.id])
          td.font-monospace.small = cooldown.command_name
          td.small = cooldown_server_label(cooldown, servers)
          td.small
            - if cooldown.active?
              span.badge.text-bg-warning = cooldown_time_left(cooldown)
            - else
              span.badge.text-bg-secondary = cooldown_time_left(cooldown)
          td.text-end
            button.btn.btn-sm.btn-link.p-0.text-decoration-none type="button" data-action="click->cooldown-filters#only" *cooldown_row_filters(cooldown, players[cooldown.id], servers)
              | Select
