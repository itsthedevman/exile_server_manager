#broadcast_modal.modal.fade[tabindex="-1" aria-labelledby="broadcast_modal_title" aria-hidden="true"]
  .modal-dialog.modal-xl.modal-dialog-centered.modal-dialog-scrollable
    .modal-content
      / modal-dialog-scrollable expects the body to be a direct child of .modal-content so it can be the flex item that
      / shrinks. The frame and the form both sit in between, so each has to carry that role itself, and overflow-hidden
      / is what lets them shrink past their content instead of running off the clipped edge with the footer.
      = turbo_frame_tag "broadcast_modal_frame", class: "d-flex flex-column overflow-hidden"
