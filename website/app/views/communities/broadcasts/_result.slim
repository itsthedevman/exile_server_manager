/ locals: result
#broadcast_result.mt-2
  - if result.nil?
  - elsif result.error.present?
    .alert.alert-danger.mb-0.py-2.small
      i.bi.bi-exclamation-triangle.me-1
      = result.error
  - elsif result.recipients.to_i.zero?
    .alert.alert-warning.mb-0.py-2.small
      i.bi.bi-info-circle.me-1
      | Nothing to send - nobody has used ESM on that server yet.
  - else
    .alert.alert-success.mb-0.py-2.small
      i.bi.bi-check-circle.me-1
      | Sent to #{pluralize(result.recipients, "player")}.
