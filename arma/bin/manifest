#!/usr/bin/env bash

# Builds and signs versions.json from an already-packaged release.
# Run bin/package first - this script never builds artifacts, it only describes them.
#
# Deliberately separate from cutting a release. Publishing a manifest is how a version gets offered to servers, and
# keeping that separate from cutting a release means a version can be retargeted or rolled back by publishing a
# new manifest, without building or tagging anything.
#
# The signing key is read from the path given to --key and is never stored in this repo. Pull it from Vaultwarden,
# run this, then remove it:
#
#   bin/manifest --key ~/updater.key && shred -u ~/updater.key

set -ueo pipefail
trap "exit" INT

##################################
# Variables
readonly root_dir="$(pwd)"
readonly release_dir=$root_dir/target/build_release

readonly crate_version=$(
    cargo pkgid -p esm |
        cut -d# -f2 |
        cut -d@ -f2
)

readonly tag="arma/v$crate_version"

# Artifacts are served off esmbot.com, not the GitHub release. The releases page stays a human-facing list of one
# zip, and the updater gets its own prefix that Rails does not route (/downloads/ belongs to the site's own links).
readonly base_url="https://esmbot.com/updates/arma/v$crate_version"

key_path=""

while [[ $# -gt 0 ]]; do
    case $1 in
    --key)
        key_path="$2"
        shift 2
        ;;
    *)
        echo "Unknown argument: $1"
        exit 1
        ;;
    esac
done

##################################
# The package has to exist before describing it is worth anything
if [[ ! -d "$release_dir/@esm" ]]; then
    echo "Fatal - $release_dir/@esm not found"
    echo "Run bin/package first"
    exit 1
fi

if [[ -z "$key_path" ]]; then
    echo "Fatal - --key is required"
    echo "  An unsigned manifest is rejected by every server, so there is no useful unsigned mode here."
    exit 1
fi

if [[ ! -f "$key_path" ]]; then
    echo "Fatal - no key at $key_path"
    exit 1
fi

##################################
# A manifest signed by a key the packaged binaries do not trust verifies nowhere. Catching it here beats watching a
# server reject the signature and having to work backwards to which of the two halves was wrong.
readonly packaged_cli=$release_dir/@esm/bin/esm_updater

if [[ -x "$packaged_cli" ]]; then
    # Both sides are the last four bytes of the DER public key, lowercase hex, matching what the build stamps in.
    built_key=$("$packaged_cli" version | grep -oE '[0-9a-f]{8}\)$' | tr -d ')')
    readonly built_key

    signing_key=$(
        openssl pkey -in "$key_path" -pubout -outform DER |
            tail -c 4 |
            od -An -tx1 |
            tr -d ' \n'
    )
    readonly signing_key

    if [[ -z "$built_key" || -z "$signing_key" ]]; then
        echo "Fatal - could not read both keys to compare them"
        echo "  package trusts: ${built_key:-<unreadable>}"
        echo "  signing with:   ${signing_key:-<unreadable>}"
        exit 1
    fi

    if [[ "$built_key" != "$signing_key" ]]; then
        echo "Fatal - this key does not match the one the package was built against"
        echo "  package trusts: $built_key"
        echo "  signing with:   $signing_key"
        echo "  Rebuild the package, or sign with the matching key."
        exit 1
    fi
fi

##################################
# Build and sign
cargo run --quiet --release -p esm_publisher -- \
    --release-dir "$release_dir" \
    --version "$crate_version" \
    --base-url "$base_url" \
    --out "$release_dir/versions.json" \
    --esm-requires-mod ">=$crate_version" \
    --key "$key_path"

##################################
# Woohoo!
echo
echo "Manifest built for $tag"
echo "  Artifacts are expected at $base_url/<filename>"
echo
echo "Publish it with bin/upload, which ships the artifacts before the manifest that describes them."
