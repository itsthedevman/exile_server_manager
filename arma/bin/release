#!/usr/bin/env bash

# Tags the current commit and publishes the packaged zip as a GitHub release.
# Run bin/package first - this script never builds anything.

set -ueo pipefail
trap "exit" INT

##################################
# Variables
readonly root_dir="$(pwd)"
readonly release_dir=$root_dir/target/build_release

readonly crate_version=$(
    cargo pkgid file://$(pwd)/src/esm |
        cut -d# -f2 |
        cut -d@ -f2
)
readonly zip_filename="@esm-$(echo "$crate_version" | sed 's/\.//g').zip"

# Tags are component-scoped because the extension shares a repo with the bot and website.
readonly tag="arma/v$crate_version"

dry_run=false

for arg in "$@"; do
    case $arg in
    --dry-run)
        dry_run=true
        ;;
    esac
done

##################################
# Functions
function echo_with_prefix() {
    echo "<esm_bt> - : $1"
}

function confirm() {
    local prompt="$1"
    while true; do
        read -p "<esm_bt> - : $prompt [y/n]: " answer
        case ${answer:-y} in
        [Yy]* | '') return 0 ;;
        [Nn]*) return 1 ;;
        *) echo_with_prefix "Please answer y/n [y]" ;;
        esac
    done
}

##################################
# The zip has to exist before any of this is worth doing
if [[ ! -f "$release_dir/$zip_filename" ]]; then
    echo_with_prefix "Fatal - $zip_filename not found in $release_dir"
    echo_with_prefix "Run bin/package first"
    exit 1
fi

echo_with_prefix "Releasing $zip_filename as $tag"

if [[ "$dry_run" == true ]]; then
    echo_with_prefix "Dry run - no tag will be created and no release will be published"
    exit 0
fi

##################################
# Tag
if git show-ref --tags "$tag" --quiet; then
    echo_with_prefix "Tag $tag already exists"
elif confirm "Create tag $tag?"; then
    git tag -a "$tag"
    git push origin "$tag"
else
    echo_with_prefix "Fatal - a tag is required to create a release"
    exit 1
fi

##################################
# Release
if ! gh auth status &>/dev/null; then
    echo_with_prefix "GitHub CLI is not authenticated - run 'gh auth login' and try again"
    exit 1
fi

assets=("$release_dir/$zip_filename")

# bin/package only produces the install bundle when the updater is included
if [[ -f "$release_dir/@esm-install.zip" ]]; then
    assets+=("$release_dir/@esm-install.zip")
fi

if confirm "Create a draft GitHub release for $tag?"; then
    gh release create "$tag" \
        --generate-notes \
        --draft \
        "${assets[@]}"
fi

##################################
# Woohoo!
echo_with_prefix "Release completed"
