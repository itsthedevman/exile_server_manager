#!/usr/bin/env bash

set -euo pipefail

docker compose up -d

docker compose exec -T mysql_db mysql -uroot -ppassword12345 < exile.sql
docker compose exec -T mysql_db mysql -uroot -ppassword12345 -Dexile_esm < src/@esm/sql/01.sql
docker compose exec -T mysql_db mysql -uroot -ppassword12345 -Dexile_esm < src/@esm/sql/02.sql

bin/build --update
