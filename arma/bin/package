#!/usr/bin/env bash

# Builds every @esm artifact and zips them for distribution. Does not tag or publish anything -
# publishing the zip is a separate step afterwards.
#
# --skip-updater leaves the auto-updater out of the package: no esm_updater.pbo, no updater
# extensions, no CLI, and no @esm-install.zip. Use it when the updater isn't ready to ship.
#
# --local builds only what a Linux x64 test server can run, skipping the other three targets, the Windows CLI, the
# tests, and both zips. It exists so bin/updater_tester can rebuild in under a minute instead of cross-compiling
# four platforms nobody is about to run. The result is not distributable and marks itself as such.

set -ueo pipefail
trap "exit" INT

##################################
# Variables
readonly root_dir="$(pwd)"
readonly build_dir=$root_dir/target/@esm
readonly release_dir=$root_dir/target/build_release

readonly crate_version=$(
    cargo pkgid -p esm |
        cut -d# -f2 |
        cut -d@ -f2
)
readonly zip_filename="@esm-$(echo "$crate_version" | sed 's/\.//g').zip"

# Seeded into installed_versions.yml, so it has to match what bin/manifest stamps for the same components.
readonly updater_version=$(
    cargo pkgid -p esm_updater |
        cut -d# -f2 |
        cut -d@ -f2
)

skip_updater=false
local_build=false

for arg in "$@"; do
    case $arg in
    --skip-updater)
        skip_updater=true
        ;;
    --local)
        local_build=true
        ;;
    esac
done

# Derived rather than hardcoded, because the two flags cut different steps out of the same run.
if [[ "$local_build" == true ]]; then
    total_steps=3
else
    total_steps=8
fi

if [[ "$skip_updater" == false ]]; then
    if [[ "$local_build" == true ]]; then
        total_steps=$((total_steps + 3))
    else
        total_steps=$((total_steps + 5))
    fi
fi

readonly total_steps

step=0

##################################
# Functions

function echo_step() {
    ((step++)) || true
    echo "----------------------------------------"
    echo "Step $step/$total_steps: $1"
    echo "----------------------------------------"
}

function run_command() {
    if ! "$@"; then
        echo "Fatal - Command failed: $*"
        return 1
    fi
}

##################################
# Run tests
# Skipped for a local build: nothing ships from one, and the suite is the single slowest step in the loop it exists
# to speed up. Run bin/test when you want them.
if [[ "$local_build" == false ]]; then
    echo_step "Running tests"
    run_command cargo test --workspace --quiet

    # The updater's integration tests are gated behind `required-features = ["testing"]`, so --workspace alone
    # silently skips every one of them. They are the only coverage of the download-verify-swap path that ships to
    # servers.
    run_command cargo test -p updater_lib --features testing --quiet
fi

##################################
# Preparation
echo_step "Preparing to build"
run_command rm -rf $build_dir
run_command rm -rf $release_dir
run_command mkdir -p $release_dir

##################################
# Build @esm
# esm_test is a test harness and never ships.
echo_step "Building @esm"
run_command ./bin/build --only=mod --release --target=linux
run_command find $build_dir/addons -mindepth 1 -type d -exec rm -rf {} +
run_command rm -f $build_dir/addons/esm_test.pbo

if [[ "$skip_updater" == true ]]; then
    run_command rm -f $build_dir/addons/esm_updater.pbo
fi

run_command cp -rf $build_dir $release_dir

##################################
# Every target but Linux x64. The manifest names artifacts per platform and the publisher skips the ones a package
# does not carry, so leaving these out yields a manifest that offers Linux x64 and nothing else - which is exactly
# what a local test server asks for.
if [[ "$local_build" == false ]]; then
    ##################################
    # Extension - Windows (x32)
    echo_step "Building esm.dll"
    run_command ./bin/build --only=extension --release --target=windows --x32
    run_command cp $build_dir/esm.dll $release_dir/@esm

    if [[ "$skip_updater" == false ]]; then
        run_command cp $build_dir/esm_updater.dll $release_dir/@esm
    fi

    ##################################
    # Extension - Windows (x64)
    echo_step "Building esm_x64.dll"
    run_command ./bin/build --only=extension --release --target=windows
    run_command cp $build_dir/esm_x64.dll $release_dir/@esm

    if [[ "$skip_updater" == false ]]; then
        run_command cp $build_dir/esm_updater_x64.dll $release_dir/@esm
    fi

    ##################################
    # Extension - Linux (x32)
    echo_step "Building esm.so"
    run_command ./bin/build --only=extension --release --target=linux --x32
    run_command cp $build_dir/esm.so $release_dir/@esm

    if [[ "$skip_updater" == false ]]; then
        run_command cp $build_dir/esm_updater.so $release_dir/@esm
    fi
fi

##################################
# Extension - Linux (x64)
echo_step "Building esm_x64.so"
run_command ./bin/build --only=extension --release --target=linux
run_command cp $build_dir/esm_x64.so $release_dir/@esm

if [[ "$skip_updater" == false ]]; then
    run_command cp $build_dir/esm_updater_x64.so $release_dir/@esm
fi

##################################
# Take the build machine out of the artifacts.
#
# The nix toolchain wraps the linker to record where its own libraries live, which is correct here and meaningless
# on a server: the RPATH names this checkout and a handful of store paths, none of which exist anywhere else. The
# loader skips what it cannot find, so nothing has ever broken, but every release has carried a local filesystem
# path in a public download.
#
# Safe because nothing here needs a path to be found. Both extensions declare only libgcc_s, libm, libc, and the
# loader itself, all of which resolve from the default search path.
for artifact in "$release_dir"/@esm/*.so; do
    [[ -e "$artifact" ]] || continue
    run_command patchelf --remove-rpath "$artifact"
done

##################################
# CLI
if [[ "$skip_updater" == false ]]; then
    echo_step "Building esm_updater CLI (Linux)"
    run_command cargo build --release -p esm_updater_cli \
        --target x86_64-unknown-linux-gnu
    run_command mkdir -p $release_dir/@esm/bin
    run_command cp \
        target/x86_64-unknown-linux-gnu/release/esm_updater \
        $release_dir/@esm/bin/esm_updater

    # Built here, run anywhere. The toolchain bakes in an ELF interpreter under /nix/store and an RPATH pointing at
    # this checkout, so as shipped the binary dies with "required file not found" on every server that is not this
    # machine, and carries a local filesystem path into a public download on the way. /lib64 is where every glibc
    # distro keeps its loader, and libc and libgcc_s resolve from the default search path without any RPATH help.
    #
    # Only the CLI needs this. The extensions are shared objects with no interpreter of their own, loaded by
    # whatever ld.so the server already runs.
    run_command patchelf \
        --set-interpreter /lib64/ld-linux-x86-64.so.2 \
        --remove-rpath \
        $release_dir/@esm/bin/esm_updater

    if [[ "$local_build" == false ]]; then
        echo_step "Building esm_updater CLI (Windows)"
        run_command cargo build --release -p esm_updater_cli \
            --target x86_64-pc-windows-gnu
        run_command cp \
            target/x86_64-pc-windows-gnu/release/esm_updater.exe \
            $release_dir/@esm/bin/esm_updater.exe
    fi
fi

##################################
# Updater artifacts that aren't part of the mod folder itself
if [[ "$skip_updater" == false ]]; then
    echo_step "Building @esm-addons.tar.gz"

    # The updater installs the mod by unpacking this over @esm/addons, so the PBOs sit at the archive root with no
    # enclosing directory. tar.gz rather than zip because that is what updater_lib knows how to extract.
    run_command tar -czf $release_dir/@esm-addons.tar.gz -C $release_dir/@esm/addons .

    # Seed the updater's record of what is installed. Without this a fresh install reads as "nothing installed",
    # and the first boot re-downloads everything the package already contains.
    echo_step "Seeding installed_versions.yml"
    cat > $release_dir/@esm/installed_versions.yml <<EOF
# Written by the ESM updater. Records the version of each component currently installed so the next
# update check knows what it is comparing against.
#
# Safe to delete. The updater treats a missing entry as "very old", so removing this file causes the
# next check to reinstall everything and write it out again.

esm: $crate_version
"@esm": $crate_version
extension_updater: $updater_version
mod_updater: $updater_version
EOF
fi

##################################
# Zipping
# A local build is missing three of the four platforms, so a zip of it would be a download waiting to disappoint
# whoever found it. The directory is still there for anything that wants to read the files directly.
if [[ "$local_build" == false ]]; then
    echo_step "Zipping $zip_filename"
    cd $release_dir && zip -r $zip_filename ./@esm

    ##################################
    # Install bundle - updater artifacts only, for a first-time install
    if [[ "$skip_updater" == false ]]; then
        echo_step "Zipping @esm-install.zip"
        cd $release_dir && zip @esm-install.zip \
            @esm/esm_updater.dll \
            @esm/esm_updater_x64.dll \
            @esm/esm_updater.so \
            @esm/esm_updater_x64.so \
            @esm/bin/esm_updater \
            @esm/bin/esm_updater.exe
    fi
fi

##################################
# Woohoo!
if [[ "$local_build" == true ]]; then
    # Left for bin/upload to find. A package this incomplete reaching servers would offer Linux x64 to everyone and
    # nothing to the platforms most of them actually run, and the missing artifacts are invisible in the manifest -
    # they simply are not there.
    touch $release_dir/.local_build

    echo "Local package built: $release_dir"
    echo "Linux x64 only, unzipped, and not publishable"
else
    echo "Package built: $release_dir/$zip_filename"

    if [[ "$skip_updater" == true ]]; then
        echo "Auto-updater was excluded from this package"
    fi

    echo "Tag and publish it when ready"
fi
