#!/usr/bin/env bash

# Stands up a signed manifest on localhost, standing in for the host a release is normally fetched from.
#
# The other half of the round is `bin/stage`, which puts one server's install into a known starting position. That
# half moved into the build tool because it writes to a container or to the Windows guest, and only the tool knows
# both shells. This half stays here: building and signing happen on this machine and nowhere else.
#
# Neither starts a server. bin/dev already does that, and a second boot path would only drift from the one being
# tested.
#
#   bin/updater_tester serve --key ~/test.key      # build, sign, and serve
#   bin/stage --esm 2.0.0                          # record the extension as a version behind
#   bin/build --updater-url <url> --start-server   # watch the boot check swap it in
#
# The key is the private half of whatever this build verifies against, which locally means whatever
# ESM_UPDATER_PUBKEY_PATH points at. bin/manifest compares the two and refuses a mismatch, so the wrong key fails
# there rather than as an unexplained signature error on a server twenty minutes later.

set -ueo pipefail
trap "exit" INT

##################################
# Variables
root_dir="$(pwd)"
readonly root_dir
readonly release_dir=$root_dir/target/build_release
readonly manifest=$release_dir/versions.json
readonly testbed_root=$root_dir/target/updater_testbed

# A container reaches the host through the firewall like anything else, so the port has to be one the host already
# allows or every fetch times out rather than failing. 54321 belongs to the distributed build receiver, which is
# idle unless a cross-machine build is running, making it the one open port free to borrow.
readonly default_port=54321

##################################
# Functions

function usage() {
    echo "Usage:"
    echo "  bin/updater_tester serve --key <path> [--port <n>] [--bind <addr>] [--base-url <url>]"
    echo "                           [--skip-build]"
    echo
    echo "Staging a server against the manifest this serves is bin/stage; see bin/build stage --help."
}

function crate_version() {
    cargo pkgid -p esm |
        cut -d# -f2 |
        cut -d@ -f2
}

##################################
# serve - build a release, sign it, and serve it the way the real host does

function run_serve() {
    local key_path=""
    local port=$default_port
    local bind=""
    local base_url=""
    local skip_build=false

    while [[ $# -gt 0 ]]; do
        case $1 in
        --key)
            key_path="$2"
            shift 2
            ;;
        --port)
            port="$2"
            shift 2
            ;;
        --bind)
            bind="$2"
            shift 2
            ;;
        --base-url)
            base_url="$2"
            shift 2
            ;;
        --skip-build)
            skip_build=true
            shift
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
        esac
    done

    if [[ -z $key_path ]]; then
        echo "Fatal - --key is required"
        echo "  Every server rejects an unsigned manifest, so there is no useful unsigned mode here."
        exit 1
    fi

    if [[ ! -f $key_path ]]; then
        echo "Fatal - no key at $key_path"
        exit 1
    fi

    # host.docker.internal resolves to the default bridge gateway from inside a container, so binding there is
    # reachable from every container while staying unreachable from the rest of the network, which 0.0.0.0 is not.
    if [[ -z $bind ]]; then
        bind=$(docker network inspect bridge -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' 2>/dev/null || true)
    fi

    if [[ -z $bind ]]; then
        echo "Fatal - could not work out the docker bridge gateway to bind to"
        echo "  Pass --bind explicitly. 0.0.0.0 works, at the cost of exposing this on your network."
        exit 1
    fi

    # host.docker.internal only resolves inside a docker container. A client that is not one, such as a Windows VM
    # on another bridge, needs the address spelled out, so --base-url overrides what goes into the manifest. It is
    # separate from --bind because they answer different questions: where this listens, and what the client dials.
    if [[ -z $base_url ]]; then
        base_url="http://host.docker.internal:$port"
    fi

    if [[ $skip_build == false ]]; then
        ./bin/package --local
    fi

    # bin/manifest appends the version directory, so a local layout matches the published one and the artifact URLs
    # the updater builds are exercised rather than bypassed.
    ./bin/manifest --key "$key_path" --base-url "$base_url"

    local version
    version=$(crate_version)
    local version_dir=$testbed_root/v$version

    rm -rf "$testbed_root"
    mkdir -p "$version_dir"

    # The manifest is the packing list, same as it is when publishing for real: artifact URLs are the base URL plus
    # a bare filename, so what to copy is exactly what versions.json points at and cannot drift from it.
    mapfile -t wanted < <(
        jq -r '.. | objects | select(has("url")) | .url' "$manifest" |
            xargs -n1 basename |
            sort -u
    )

    local name path
    for name in "${wanted[@]}"; do
        path=$(find "$release_dir" -type f -name "$name" -print -quit)

        if [[ -z $path ]]; then
            echo "Fatal - $name is named in the manifest but is not in the package"
            exit 1
        fi

        cp "$path" "$version_dir/$name"
    done

    cp "$manifest" "$manifest.sig" "$testbed_root/"

    echo
    echo "Serving $testbed_root on $bind:$port"
    echo "  manifest: $base_url/versions.json"
    echo "  artifacts: ${#wanted[@]} under v$version"
    echo
    echo "Stage a server behind it, then point its boot check here:"
    echo "  bin/stage --esm <version>"
    echo "  bin/build --updater-url $base_url/versions.json --start-server"
    echo
    echo "A container that cannot reach this is being stopped by the host firewall, not by anything here:"
    echo "the fetch times out rather than refusing. Serve on a port the host already allows."
    echo

    # Not `python3 -m http.server`, which is single-threaded and dies on the first client that drops a
    # connection: a port probe, an updater that times out, a browser tab closed mid-download. It exits with a
    # ConnectionResetError traceback, and every later fetch then fails as a refused connection, which reads as
    # a broken updater rather than as a server that is no longer there.
    cd "$testbed_root" || exit 1

    exec python3 -c '
import sys
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer


class Server(ThreadingHTTPServer):
    daemon_threads = True
    # A client hanging up is routine here and says nothing about the manifest. Swallow it rather than let the
    # default handler print a traceback that looks like the server broke.
    def handle_error(self, request, client_address):
        kind = sys.exc_info()[0]
        if kind is not None and issubclass(kind, (ConnectionResetError, BrokenPipeError, ConnectionAbortedError)):
            return
        super().handle_error(request, client_address)


bind, port = sys.argv[1], int(sys.argv[2])
Server((bind, port), partial(SimpleHTTPRequestHandler, directory=".")).serve_forever()
' "$bind" "$port"
}

##################################
# Dispatch
if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

readonly subcommand=$1
shift

case $subcommand in
serve)
    run_serve "$@"
    ;;
--help | -h | help)
    usage
    ;;
*)
    echo "Unknown subcommand: $subcommand"
    echo
    usage
    exit 1
    ;;
esac
