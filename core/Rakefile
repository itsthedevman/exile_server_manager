# frozen_string_literal: true

require "bundler/gem_tasks"
require "standard/rake"
require "rspec/core/rake_task"
require "active_record"

RSpec::Core::RakeTask.new(:spec)

task default: %i[standard spec]

# Database configuration
def db_config
  {
    adapter: "postgresql",
    encoding: "unicode",
    pool: 5,
    host: ENV.fetch("POSTGRES_HOST", "localhost"),
    port: ENV.fetch("POSTGRES_PORT", "5432"),
    database: ENV.fetch("POSTGRES_DATABASE", "esm_ruby_core_test"),
    username: ENV.fetch("POSTGRES_USERNAME", "esm"),
    password: ENV.fetch("POSTGRES_PASSWORD", "password12345")
  }
end

namespace :db do
  desc "Create the database"
  task :create do
    config = db_config.dup
    database = config.delete(:database)
    ActiveRecord::Base.establish_connection(config.merge(database: "postgres"))
    ActiveRecord::Base.connection.create_database(database, encoding: "unicode")
    puts "Created database '#{database}'"
  rescue ActiveRecord::DatabaseAlreadyExists
    puts "Database '#{database}' already exists"
  end

  desc "Drop the database"
  task :drop do
    config = db_config.dup
    database = config.delete(:database)
    ActiveRecord::Base.establish_connection(config.merge(database: "postgres"))
    ActiveRecord::Base.connection.drop_database(database)
    puts "Dropped database '#{database}'"
  rescue ActiveRecord::NoDatabaseError
    puts "Database '#{database}' does not exist"
  end

  desc "Run migrations"
  task :migrate do
    ActiveRecord::Base.establish_connection(db_config)
    ActiveRecord::MigrationContext.new("db/migrate").migrate
    puts "Migrations complete"
  end

  desc "Rollback the last migration"
  task :rollback do
    ActiveRecord::Base.establish_connection(db_config)
    ActiveRecord::MigrationContext.new("db/migrate").rollback
    puts "Rollback complete"
  end

  desc "Show migration status"
  task :status do
    ActiveRecord::Base.establish_connection(db_config)
    ActiveRecord::MigrationContext.new("db/migrate").migrations_status.each do |status, version, name|
      puts "#{status.center(8)} #{version.ljust(14)} #{name}"
    end
  end
end
