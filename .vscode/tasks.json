{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Active Record migration (bot)",
      "type": "shell",
      "command": "cd ${workspaceFolder}/service && direnv exec . bundle exec rake db:new_migration name=${input:migrationName}",
      "presentation": {
        "echo": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Please enter migration name:"
    }
  ]
}
